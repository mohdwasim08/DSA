   "source": [
    "class Solution:\n",
    "    def linearSearch(self, nums, target):\n",
    "\n",
    "        for i in range(len(nums)):\n",
    "            if nums[i] == target:\n",
    "                return i\n",
    "\n",
    "        return -1\n",
    "\n",
    "\n",
    "obj = Solution()\n",
    "print(obj.linearSearch([2, 3, 4, 5, 3], 3))"
   ]
  },
