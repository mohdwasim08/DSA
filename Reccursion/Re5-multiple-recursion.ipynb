     },
     "execution_count": 1,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "n = int(input('enter the number:'))\n",
    "def f(n):\n",
    "\n",
    "    # Base case\n",
    "    if (n <= 1):\n",
    "        return n\n",
    "    last = f(n-1)\n",
    "    slast = f(n-2)\n",
    "    return last + slast     \n",
    "f(n)"
   ]
  },
